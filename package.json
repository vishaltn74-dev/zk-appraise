{
  "name": "zk-appraise",
  "version": "1.0.0",
  "description": "ZK-Appraise: A ZKML app enabling home equity borrowers to prove DeFi loan collateral eligibility via local AI real estate valuations. It generates cryptographic proofs without exposing raw property specs or addresses to public ledgers. Tech Stack: Python/ONNX, EZKL, Midnight Compact, React.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run contracts/tests/",
    "test:contracts": "vitest run contracts/tests/",
    "build:frontend": "npm run --prefix frontend build",
    "dev:frontend": "npm run --prefix frontend dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishaltn74-dev/zk-appraise.git"
  },
  "keywords": [
    "zero-knowledge",
    "zkml",
    "midnight-network",
    "compact",
    "real-estate-appraisal",
    "defi-lending"
  ],
  "bugs": {
    "url": "https://github.com/vishaltn74-dev/zk-appraise/issues"
  },
  "homepage": "https://github.com/vishaltn74-dev/zk-appraise#readme",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js": "^4.1.1"
  }
