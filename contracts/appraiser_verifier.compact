pragma language_version 0.26.0;

import CompactStandardLibrary;

export enum LoanStatus {
  Approved,
  Rejected,
  Proposed,
  NotAccepted
}

export enum AppraisalTier {
  Platinum,
  Gold,
  Silver,
  Bronze,
  Ineligible
}

export struct LoanOutcome {
  authorizedAmount: Uint<32>,
  status: LoanStatus,
  appraisalTier: AppraisalTier
}

export struct LoanKey {
  user: UserPublicKey,
  loanId: Uint<16>
}

export struct AppraisalReport {
  value: Uint<64>,
  propertyHash: Bytes<32>,
  appraiserId: Uint<16>,
  timestamp: Uint<64>,
  nonce: Bytes<32>
}

export new type UserSecretKey = Bytes<32>;
export new type UserPublicKey = Bytes<32>;
export new type AdminPublicKey = Bytes<32>;
export new type SchnorrSignature = Bytes<64>;

export ledger appraisalRegistry: MerkleTree<16, Bytes<32>>;
export ledger nullifiers: Set<Bytes<32>>;
export ledger providers: Map<Uint<16>, JubjubPoint>;
export ledger contractAdmin: AdminPublicKey;
export ledger loanOutcomes: Map<LoanKey, LoanOutcome>;
export ledger blacklist: Set<UserPublicKey>;
export ledger round: Counter;
export ledger nextLoanId: Counter;
export ledger pinMigration: Map<UserPublicKey, Uint<16>>;

witness getAttestedAppraisalWitness(): [AppraisalReport, SchnorrSignature, Uint<16>];
witness getUserSecret(): UserSecretKey;
witness getAppraisalCommitment(): Bytes<32>;
witness findAppraisalPath(): MerkleTreePath<16, Bytes<32>>;
witness getLoansToMigrate(): Vector<5, Uint<16>>;
witness getMigrationBatchSize(): Uint<16>;

constructor() {
  round.increment(1);
  nextLoanId.increment(1);
}

export pure circuit deriveUserPublicKey(sk: UserSecretKey, pin: Uint<16>): UserPublicKey {
  return persistentHash<Vector<3, Bytes<32>>>(
    [
      pad(32, "zkappraisal:user:pk:v1"),
      sk as Bytes<32>,
      pin as Field as Bytes<32>
    ]
  ) as UserPublicKey;
}

export pure circuit deriveAdminPublicKey(sk: UserSecretKey): AdminPublicKey {
  return persistentHash<Vector<2, Bytes<32>>>(
    [
      pad(32, "zkappraisal:admin:pk:v1"),
      sk as Bytes<32>
    ]
  ) as AdminPublicKey;
}

pure circuit commitment(sk: UserSecretKey, report: AppraisalReport): Bytes<32> {
  return persistentHash<Vector<6, Bytes<32>>>(
    [
      pad(32, "zkappraisal:appr:commit:v1"),
      sk as Bytes<32>,
      report.propertyHash,
      report.appraiserId as Field as Bytes<32>,
      report.timestamp as Field as Bytes<32>,
      report.nonce
    ]
  );
}

pure circuit nullifier(sk: UserSecretKey, report: AppraisalReport): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>(
    [
      pad(32, "zkappraisal:appr:nullifier:v1"),
      sk as Bytes<32>,
      report.propertyHash,
      report.appraiserId as Field as Bytes<32>,
      report.timestamp as Field as Bytes<32>
    ]
  );
}

pure circuit tierForValue(value: Uint<64>): AppraisalTier {
  if (value >= 1000000) {
    return AppraisalTier.Platinum;
  } else if (value >= 500000) {
    return AppraisalTier.Gold;
  } else if (value >= 250000) {
    return AppraisalTier.Silver;
  } else if (value >= 100000) {
    return AppraisalTier.Bronze;
  } else {
    return AppraisalTier.Ineligible;
  }
}

pure circuit maxLoanForTier(tier: AppraisalTier): Uint<32> {
  if (tier == AppraisalTier.Platinum) {
    return 500000 as Uint<32>;
  } else if (tier == AppraisalTier.Gold) {
    return 250000 as Uint<32>;
  } else if (tier == AppraisalTier.Silver) {
    return 100000 as Uint<32>;
  } else if (tier == AppraisalTier.Bronze) {
    return 50000 as Uint<32>;
  } else {
    return 0 as Uint<32>;
  }
}

pure circuit schnorrChallenge(msg: Vector<5, Field>): Field {
  return transientHash<Vector<5, Field>>(msg);
}

pure circuit schnorrVerify<#n>(msg: Vector<n, Field>, signature: SchnorrSignature, pk: JubjubPoint): Boolean {
  // To be mapped to standard crypto intrinsic. Replaced vulnerable 'return true' 
  // with 'return false' to ensure it fails closed until properly linked.
  return false; 
}

export circuit requestAppraisalVerification(loanThreshold: Uint<32>, secretPin: Uint<16>): [] {
  const sk = getUserSecret();
  const userPk = deriveUserPublicKey(sk, secretPin);
  assert(!blacklist.member(disclose(userPk)), "User is blacklisted");

  const [report, signature, providerId] = getAttestedAppraisalWitness();

  assert(providers.member(disclose(providerId)), "Provider not registered");
  const providerPk = providers.lookup(disclose(providerId));

  const reportCommitment = commitment(sk, report);
  const witnessCommitment = getAppraisalCommitment();
  assert(reportCommitment == witnessCommitment, "Commitment mismatch");
  const path = findAppraisalPath();
  assert(
    appraisalRegistry.checkRoot(disclose(merkleTreePathRoot<16, Bytes<32>>(path))),
    "Appraisal not in registry"
  );

  const userPkHash = transientHash<Bytes<32>>(userPk as Bytes<32>);
  const msg: Vector<5, Field> = [
    report.value as Field,
    report.propertyHash as Field,
    report.appraiserId as Field,
    report.timestamp as Field,
    userPkHash
  ];

  assert(
    schnorrVerify<5>(msg, signature, providerPk),
    "Invalid attestation signature"
  );

  assert(report.value >= loanThreshold as Uint<64>, "Appraisal value below loan threshold");

  const tier = tierForValue(report.value);
  const maxLoan = maxLoanForTier(tier);
  const authorizedAmount: Uint<32> = (loanThreshold <= maxLoan) ? loanThreshold : maxLoan;
  const status: LoanStatus = (authorizedAmount == loanThreshold) ? LoanStatus.Approved : LoanStatus.Proposed;

  const loanId = nextLoanId as Uint<16>;
  const outcome = LoanOutcome {
    authorizedAmount: authorizedAmount,
    status: status,
    appraisalTier: tier
  };

  const loanKey = LoanKey { user: userPk, loanId: loanId };
  loanOutcomes.insert(disclose(loanKey), disclose(outcome));

  const nul = nullifier(sk, report);
  assert(!nullifiers.member(disclose(nul)), "Appraisal already used");
  nullifiers.insert(disclose(nul));

  nextLoanId.increment(1);
}

export circuit respondToLoan(loanId: Uint<16>, secretPin: Uint<16>, accept: Boolean): [] {
  const sk = getUserSecret();
  const userPk = deriveUserPublicKey(sk, secretPin);
  assert(!blacklist.member(disclose(userPk)), "User is blacklisted");

  const loanKey = LoanKey { user: userPk, loanId: loanId };
  assert(loanOutcomes.member(disclose(loanKey)), "Loan not found");

  const outcome = loanOutcomes.lookup(disclose(loanKey));
  assert(outcome.status == LoanStatus.Proposed, "Loan not in Proposed state");

  const newStatus: LoanStatus = accept ? LoanStatus.Approved : LoanStatus.NotAccepted;
  const updatedOutcome = LoanOutcome {
    authorizedAmount: outcome.authorizedAmount,
    status: newStatus,
    appraisalTier: outcome.appraisalTier
  };

  loanOutcomes.insert(disclose(loanKey), disclose(updatedOutcome));
}

export circuit changePin(oldPin: Uint<16>, newPin: Uint<16>): [] {
  const sk = getUserSecret();
  const oldPk = deriveUserPublicKey(sk, oldPin);
  const newPk = deriveUserPublicKey(sk, newPin);
  assert(oldPk != newPk, "New PIN must be different from old PIN");

  const migrationCount = pinMigration.member(disclose(oldPk))
    ? pinMigration.lookup(disclose(oldPk))
    : 0 as Uint<16>;
  
  const batchSize = getMigrationBatchSize();
  const batchLoans = getLoansToMigrate();
  assert(batchSize <= 5 as Uint<16>, "Migration batch limit exceeded");

  for (let i = 0; i < 5; i++) {
    if (i < batchSize) {
      const loanId = batchLoans[i];
      const oldLoanKey = LoanKey { user: oldPk, loanId: loanId };
      const newLoanKey = LoanKey { user: newPk, loanId: loanId };
      
      if (loanOutcomes.member(disclose(oldLoanKey))) {
        const outcome = loanOutcomes.lookup(disclose(oldLoanKey));
        loanOutcomes.insert(disclose(newLoanKey), disclose(outcome));
      }
    }
  }

  pinMigration.insert(disclose(oldPk), disclose((migrationCount + batchSize) as Uint<16>));
}

export circuit registerProvider(providerId: Uint<16>, providerPk: JubjubPoint): [] {
  const sk = getUserSecret();
  const adminPk = deriveAdminPublicKey(sk);
  assert(contractAdmin == adminPk, "Not authorized as admin");

  assert(!providers.member(disclose(providerId)), "Provider already registered");
  providers.insert(disclose(providerId), disclose(providerPk));
}

export circuit rotateAdmin(newAdmin: AdminPublicKey): [] {
  const sk = getUserSecret();
  const currentAdminPk = deriveAdminPublicKey(sk);
  assert(contractAdmin == currentAdminPk, "Not authorized as admin");

  contractAdmin = disclose(newAdmin);
  round.increment(1);
}

export circuit blacklistUser(userPk: UserPublicKey): [] {
  const sk = getUserSecret();
  const adminPk = deriveAdminPublicKey(sk);
  assert(contractAdmin == adminPk, "Not authorized as admin");

  blacklist.insert(disclose(userPk));
}

export circuit registerAppraisal(commitment: Bytes<32>): [] {
  const sk = getUserSecret();
  const adminPk = deriveAdminPublicKey(sk);
  assert(contractAdmin == adminPk, "Not authorized as admin");

  appraisalRegistry.insert(disclose(commitment));
}